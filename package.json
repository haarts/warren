{
  "name": "ductwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MEP overlay drawing app - draw pipes, ducts and circuits on top of architect floor plan PDFs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:browser": "node test/browser/smoke.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "puppeteer-core": "^24.0.0"
  }
}
